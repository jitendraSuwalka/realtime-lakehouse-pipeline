# ---------------------------------------------------------------------------
# Redshift SERVERLESS - the real warehouse (Postgres stood in locally).
# Two halves, by design:
#   NAMESPACE = the data half  (databases, users, the IAM role for COPY)
#   WORKGROUP = the compute half (capacity, network access)
# Serverless billing: you pay ONLY while queries are actually computing
# (per RPU-second), so a dormant workgroup costs compute of £0.
# ---------------------------------------------------------------------------

# The admin password: generated by Terraform, never typed, never committed.
# It lives in the (gitignored) state file; read it when needed with:
#   terraform output -raw redshift_admin_password
resource "random_password" "redshift_admin" {
  length           = 20
  min_upper        = 1
  min_lower        = 1
  min_numeric      = 1
  override_special = "!#$%&*()-_+=" # Redshift forbids ' " / @ \ and spaces
}

resource "aws_redshiftserverless_namespace" "lakehouse" {
  namespace_name      = "${var.project}-ns"
  db_name             = "lakehouse"
  admin_username      = "lakehouse_admin"
  admin_user_password = random_password.redshift_admin.result

  # Attach the COPY role, and make it the DEFAULT role - which is what
  # lets our loader write simply:  COPY ... IAM_ROLE default
  iam_roles            = [aws_iam_role.redshift_copy.arn]
  default_iam_role_arn = aws_iam_role.redshift_copy.arn

  tags = { Project = var.project }
}

# --- network: who may talk to the warehouse --------------------------------
data "aws_vpc" "default" {
  default = true
}

data "aws_subnets" "default" {
  filter {
    name   = "vpc-id"
    values = [data.aws_vpc.default.id]
  }
}

resource "aws_security_group" "redshift" {
  name        = "${var.project}-redshift"
  description = "Redshift Serverless access - your laptop only"
  vpc_id      = data.aws_vpc.default.id

  ingress {
    description = "Redshift port from MY laptop's IP only"
    from_port   = 5439
    to_port     = 5439
    protocol    = "tcp"
    cidr_blocks = [var.my_ip]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Project = var.project }
}

resource "aws_redshiftserverless_workgroup" "lakehouse" {
  workgroup_name = "${var.project}-wg"
  namespace_name = aws_redshiftserverless_namespace.lakehouse.namespace_name

  base_capacity = 8 # RPUs - the serverless minimum; plenty for us
  max_capacity  = 8 # hard ceiling: it can never scale (= spend) above base

  publicly_accessible = true # reachable from the laptop...
  security_group_ids  = [aws_security_group.redshift.id] # ...but ONLY from my_ip
  subnet_ids          = data.aws_subnets.default.ids

  tags = { Project = var.project }
}
